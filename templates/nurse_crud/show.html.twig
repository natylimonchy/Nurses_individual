{% extends 'base.html.twig' %}

{% block title %}Nurse{% endblock %}

{% block body %}
    <h1>Nurse</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ nurse.id }}</td>
            </tr>
            <tr>
                <th>InternalId</th>
                <td>{{ nurse.internalId }}</td>
            </tr>
            <tr>
                <th>FirstName</th>
                <td>{{ nurse.firstName }}</td>
            </tr>
            <tr>
                <th>LastName</th>
                <td>{{ nurse.lastName }}</td>
            </tr>
            <tr>
                <th>LicenseNumber</th>
                <td>{{ nurse.licenseNumber }}</td>
            </tr>
            <tr>
                <th>Username</th>
                <td>{{ nurse.username }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ nurse.password }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ nurse.email }}</td>
            </tr>
            <tr>
                <th>Shift</th>
                <td>{{ nurse.shift }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_nurse_crud_index') }}">back to list</a>

    <a href="{{ path('app_nurse_crud_edit', {'id': nurse.id}) }}">edit</a>

    {{ include('nurse_crud/_delete_form.html.twig') }}
